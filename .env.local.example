# Copie para .env.local e preencha com suas chaves reais.
# NUNCA versione .env.local (já está no .gitignore).

# Convex — gerado por `npx convex dev` (aparece no terminal e no dashboard).
VITE_CONVEX_URL=https://SEU-DEPLOYMENT.convex.cloud

# Clerk — painel do Clerk > API Keys > Publishable key.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Observação: CLERK_JWT_ISSUER_DOMAIN NÃO vai aqui — é variável do Convex.
# Defina com: npx convex env set CLERK_JWT_ISSUER_DOMAIN https://SEU-DOMINIO.clerk.accounts.dev

# Só em produção sem domínio próprio (ex.: *.vercel.app, onde não dá pra apontar
# o CNAME clerk.<dominio>): o Clerk usa proxy pelo próprio domínio no lugar do
# DNS. Deixe VAZIO em dev — lá o DNS de *.clerk.accounts.dev funciona normal.
# VITE_CLERK_PROXY_URL=/__clerk
